<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EBay.Communication</RootNamespace>
    <AssemblyName>EBay.Communication</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EBay.Communication</PackageId>
    <Version>0.3.0</Version>
    <Authors>eBay</Authors>
    <Description>Communication SDK for eBay Feedback, Message, Notification, and Negotiation APIs</Description>
    <PackageProjectUrl>https://github.com/eBay/communication-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/communication-dotnet-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
  </ItemGroup>

</Project>
